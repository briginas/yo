{
    "name": "yo",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.18.0"
    },
    "scripts": {
        "build": "tsc --noEmit && esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/cli.js",
        "test": "node --test",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "dev": "npm run build && node dist/cli.js"
    },
    "devDependencies": {
        "esbuild": "^0.28.1",
        "prettier": "^3.7.4",
        "typescript": "7.0.2"
    }
}
